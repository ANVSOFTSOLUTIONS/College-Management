APP_NAME=College Management API
API_PREFIX=/api/v1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=school_management
CORS_ORIGINS=http://localhost:5173

# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# Encrypts secrets stored in the database (a school's payment gateway secret key).
# Required before a school saves Razorpay, Cashfree or PhonePe keys. Generate once and keep it safe;
# changing it makes saved secrets unreadable (schools would re-enter them):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Parent SMS alerts (absences, missed exams). Leave SMS_ENABLED=false until a
# provider is set up; alerts are still recorded and shown as "not sent".
# MSG91: DLT-approved flow template IDs, one per alert kind. See
# backend/app/integrations/sms.py for the variables each template receives.
SMS_ENABLED=false
SMS_PROVIDER=msg91
SMS_MSG91_AUTH_KEY=
SMS_MSG91_TEMPLATE_ABSENCE=
SMS_MSG91_TEMPLATE_REMARK=
SMS_MSG91_TEMPLATE_FEE=

# Backups (see docs/BACKUPS.md). BACKUP_TOKEN is the secret the daily cron job sends;
# generate one with: python -c "import secrets; print(secrets.token_hex(24))"
BACKUP_TOKEN=
BACKUP_DIR=
MYSQLDUMP_PATH=mysqldump

# Demo requests from the landing page are emailed to DEMO_REQUEST_EMAILS.
# Off until SMTP_HOST is set. For a cPanel mailbox: SMTP_HOST=mail.anvsoftsolutions.com,
# SMTP_PORT=465 with SMTP_USE_SSL=true (or 587 with SMTP_USE_SSL=false).
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEMO_REQUEST_EMAILS=support@anvsoftsolutions.com,sales@anvsoftsolutions.com
