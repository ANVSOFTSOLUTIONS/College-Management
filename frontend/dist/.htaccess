# Apache (cPanel): serve index.html for client-side routes so a page refresh
# on e.g. /dashboard doesn't 404. Real files and directories are served as-is.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Installable app (PWA): the service worker, manifest, and page must never be
# cached by the browser, or phones keep running an old version.
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
