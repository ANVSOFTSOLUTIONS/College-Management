{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://collegeapi.anvsoftsolutions.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://college.anvsoftsolutions.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://collegeapi.anvsoftsolutions.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://college.anvsoftsolutions.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
